# Waypoint — local environment variables
# Copy this file to .env.local and fill in the values that `supabase status`
# prints. .env.local is gitignored.

# Public site URL — used to build email magic-link redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — printed by `supabase status` after `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-status

# Server-only — NEVER commit, NEVER expose to the browser. Currently
# unused in Phase 1; reserved for future server-side admin operations
# (e.g. user delete flow).
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-from-supabase-status
